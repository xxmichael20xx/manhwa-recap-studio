{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MinimalSceneJSON",
  "type": "object",
  "required": [
    "id",
    "batch",
    "tier",
    "zone",
    "chars",
    "items",
    "panels",
    "visual_literal"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IMG_\\d{3,4}$"
    },
    "batch": {
      "type": "integer",
      "minimum": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "zone": {
      "type": "string"
    },
    "transition": {
      "type": "string",
      "enum": [
        "adjacent",
        "cut",
        "flashback",
        "cutaway"
      ],
      "default": "adjacent"
    },
    "chars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outfit": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "lifecycle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "equipped",
              "sheathed",
              "environmental",
              "destroyed"
            ]
          },
          "holder": {
            "type": "string"
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "visual_literal": {
      "type": "string",
      "minLength": 5
    },
    "events": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "e",
          "set"
        ],
        "properties": {
          "e": {
            "type": "string"
          },
          "set": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}